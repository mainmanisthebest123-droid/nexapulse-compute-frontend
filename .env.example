# Cloudflare Worker API base URL
VITE_COMPUTE_API_URL=https://nexapulse-compute.blacknick517.workers.dev

# Supabase public client configuration used only for owner sign-in.
# Prefer the project's publishable key. The legacy anon key is also supported.
# Never put the service-role key or Worker secrets in Vite variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional backwards-compatible fallback:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_SUPABASE_ANON_KEY
